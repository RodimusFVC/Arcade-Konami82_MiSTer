    <players>2 (alternating)</players>
    <joystick>8-way</joystick>
    <special_controls></special_controls>
    <num_buttons>3</num_buttons>
    <buttons names="Fire,Warp,Button 3,Not Used,Coin,Start 1P,Start 2P,Pause,Not Used,Not Used,Not Used" default="A,B,X,Y,Select,Start,R,L"/>

    <switches default="FF,7B">
        <dip name="Coin A" bits="0,3" ids="4C/1C,3C/1C,2C/1C,3C/2C,4C/3C,1C/1C,3C/4C,2C/3C,1C/2C,2C/5C,1C/3C,1C/4C,1C/5C,1C/6C,1C/7C,Free Play" values="2,5,8,4,1,15,3,7,14,6,13,12,11,10,9,0"/>
        <dip name="Coin B" bits="4,7" ids="4C/1C,3C/1C,2C/1C,3C/2C,4C/3C,1C/1C,3C/4C,2C/3C,1C/2C,2C/5C,1C/3C,1C/4C,1C/5C,1C/6C,1C/7C,No Coin B" values="2,5,8,4,1,15,3,7,14,6,13,12,11,10,9,0"/>
        <dip name="Lives" bits="8,9" ids="3,4,5,256 (Cheat)" values="3,2,1,0"/>
        <dip name="Cabinet" bits="10" ids="Upright,Cocktail"/>
        <dip name="Difficulty" bits="12,14" ids="1 (Easiest),2,3,4,5,6,7,8 (Hardest)" values="7,6,5,4,3,2,1,0"/>
        <dip name="Demo Sounds" bits="15" ids="Off,On" values="1,0"/>
    </switches>

