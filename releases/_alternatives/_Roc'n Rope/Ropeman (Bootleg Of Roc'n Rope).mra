<misterromdescription>
    <name>Ropeman (Bootleg Of Roc'n Rope)</name>
    <region>World</region>
    <homebrew>no</homebrew>
    <bootleg>yes</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>Roc'n Rope</series>
    <year>1983</year>
