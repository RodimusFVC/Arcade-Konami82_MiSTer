    <rbf>Konami82</rbf>
    <about></about>

    <resolution>15kHz</resolution>
    <rotation>vertical (cw)</rotation>
    <flip>yes</flip>

    <players>2 (alternating)</players>
    <joystick>8-way</joystick>
    <special_controls></special_controls>
    <num_buttons>1</num_buttons>
    <buttons names="Fire,Not Used,Not Used,Not Used,Coin,Start 1P,Start 2P,Pause,Not Used,Not Used,Not Used" default="A,B,X,Y,Select,Start,R,L"/>

    <switches default="FF,23,FE">
        <dip name="Coin A" bits="0,3" ids="4C/1C,3C/1C,2C/1C,3C/2C,4C/3C,1C/1C,3C/4C,2C/3C,1C/2C,2C/5C,1C/3C,1C/4C,1C/5C,1C/6C,1C/7C,Free Play" values="2,5,8,4,1,15,3,7,14,6,13,12,11,10,9,0"/>
        <dip name="Coin B" bits="4,7" ids="4C/1C,3C/1C,2C/1C,3C/2C,4C/3C,1C/1C,3C/4C,2C/3C,1C/2C,2C/5C,1C/3C,1C/4C,1C/5C,1C/6C,1C/7C,Free Play" values="2,5,8,4,1,15,3,7,14,6,13,12,11,10,9,0"/>
        <dip name="Lives" bits="8,9" ids="3,4,5,255 (Cheat)" values="3,2,1,0"/>
        <dip name="Cabinet" bits="10" ids="Upright,Cocktail"/>
        <dip name="Demo Sounds" bits="15" ids="Off,On" values="1,0"/>
        <dip name="Bonus Life" bits="11" ids="50k 120k 70k+,60k 140k 80k+" values="1,0"/>
        <dip name="Difficulty" bits="12,14" ids="1 (Easiest),2,3,4,5 (Average),6,7,8 (Hardest)" values="7,6,5,4,3,2,1,0"/>
        <dip name="Demo Music" bits="16" ids="Off,On" values="1,0"/>
    </switches>

