<misterromdescription>
    <name>Venus (Bootleg Of Gyruss)</name>
    <region>World</region>
    <homebrew>no</homebrew>
    <bootleg>yes</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>Gyruss</series>
    <year>1983</year>
