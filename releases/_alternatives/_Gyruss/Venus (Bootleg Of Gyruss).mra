        <part>
            00 56 A0 00 00 FF 00 02 00 02 00 01 11 11 00 00
            00 00 94 89 00 26 00 D3
            00 00 94 0B 00 03 00 01
        </part>
    </rom>
    <rom index="4"></rom>
