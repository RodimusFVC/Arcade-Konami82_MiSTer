<misterromdescription>
    <name>Tutankham</name>
    <region>World</region>
    <homebrew>no</homebrew>
    <bootleg>no</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>Tutankham</series>
    <year>1982</year>
    <manufacturer>Konami</manufacturer>
    <category>Maze</category>

    <setname>tutankhm</setname>
    <parent>tutankhm</parent>
    <mameversion>0289</mameversion>
    <rbf>Konami82</rbf>
    <about></about>

    <resolution>15kHz</resolution>
    <rotation>vertical (cw)</rotation>
    <flip>yes</flip>

    <players>2 (alternating)</players>
    <joystick>4-way</joystick>
    <special_controls>twin stick (2-way fire stick)</special_controls>
    <num_buttons>3</num_buttons>
    <buttons names="Fire Right,Fire Left,Flash Bomb,Not Used,Coin,Start 1P,Start 2P,Pause,Not Used,Not Used,Not Used" default="A,B,X,Y,Select,Start,R,L"/>

    <switches default="FF,6B">
        <dip name="Coin A" bits="0,3" ids="4C/1C,3C/1C,2C/1C,3C/2C,4C/3C,1C/1C,3C/4C,2C/3C,1C/2C,2C/5C,1C/3C,1C/4C,1C/5C,1C/6C,1C/7C,Free Play" values="2,5,8,4,1,15,3,7,14,6,13,12,11,10,9,0"/>
        <dip name="Coin B" bits="4,7" ids="4C/1C,3C/1C,2C/1C,3C/2C,4C/3C,1C/1C,3C/4C,2C/3C,1C/2C,2C/5C,1C/3C,1C/4C,1C/5C,1C/6C,1C/7C,No Coin B" values="2,5,8,4,1,15,3,7,14,6,13,12,11,10,9,0"/>
        <dip name="Lives" bits="8,9" ids="3,4,5,255 (Cheat)" values="3,1,2,0"/>
        <dip name="Cabinet" bits="10" ids="Upright,Cocktail"/>
        <dip name="Bonus Life" bits="11" ids="30000,40000" values="1,0"/>
        <dip name="Difficulty" bits="12,13" ids="Easy,Normal,Hard,Hardest" values="3,2,1,0"/>
        <dip name="Flash Bomb" bits="14" ids="1 per Life,1 per Game" values="1,0"/>
        <dip name="Demo Sounds" bits="15" ids="Off,On" values="1,0"/>
    </switches>

    <!-- Index 0: 8K ROM banks (rtl/konami82_board.sv), PROMs at their window address in rtl/boards/tutankhm_board.sv -->
    <rom index="0" md5="none" zip="tutankhm.zip">
        <part crc="7eb59b21" name="c1.1i"/>
        <part crc="6615eff3" name="c2.2i"/>
        <part crc="a10d4444" name="c3.3i"/>
